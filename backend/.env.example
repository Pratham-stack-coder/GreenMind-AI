# ==============================================================================
# GreenMind AI — Backend Environment Configuration Template
# ==============================================================================

# Application Mode
DEMO_MODE=true
APP_NAME=GreenMind AI
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# Supabase Auth required for API access
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Required to save encrypted per-user cloud provider credentials
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Optional Database & Cache (falls back to local SQLite; Redis stays disabled)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/greenmind
# REDIS_URL=redis://localhost:6379/0

# Optional server LLM keys for system-managed operations. Signed-in users save their own keys in Settings.
# GEMINI_API_KEY=your_google_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional Real-time Carbon Intensity Providers
# ELECTRICITY_MAPS_API_KEY=your_electricity_maps_token
# WATTTIME_USERNAME=your_watttime_username
# WATTTIME_PASSWORD=your_watttime_password

# Optional system/background cloud credentials. Signed-in users configure isolated credentials in Settings.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# AZURE_SUBSCRIPTION_ID=...
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# GCP_PROJECT_ID=...
# GCP_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
