# ==============================================================================
# GreenMind AI — Backend Environment Configuration Template
# ==============================================================================

# Application Mode
DEMO_MODE=true
APP_NAME=GreenMind AI
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# Optional Database & Cache (falls back to in-memory if left empty)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/greenmind
# REDIS_URL=redis://localhost:6379/0

# Optional LLM Copilot Keys (defaults to intelligent rule-based engine if not set)
# GEMINI_API_KEY=your_google_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional Real-time Carbon Intensity Providers
# ELECTRICITY_MAPS_API_KEY=your_electricity_maps_token
# WATTTIME_USERNAME=your_watttime_username
# WATTTIME_PASSWORD=your_watttime_password

# Optional Cloud Provider Credentials (for Live multi-cloud telemetry)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# AZURE_SUBSCRIPTION_ID=...
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# GCP_PROJECT_ID=...
# GCP_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
