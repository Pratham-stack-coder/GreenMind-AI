# Backend environment template; see README.md and SECURITY.md.
DEMO_MODE=true
APP_ENV=development
APP_NAME=GreenMind AI
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# Exact-match comma/semicolon-separated origins; do not use wildcard patterns.
ALLOWED_ORIGINS=https://greenmind-ai.vercel.app
CORS_ORIGINS=

# Supabase access-token validation. Publishable key is only for legacy HS256 token validation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SQLite default when blank; use a PostgreSQL URL for persistent deployment data.
DATABASE_URL=
REDIS_URL=

# LLM providers are optional; Copilot should use rule-based fallback when absent.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Optional read-only cloud telemetry credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# Optional carbon-intensity APIs
ELECTRICITY_MAPS_API_KEY=
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
