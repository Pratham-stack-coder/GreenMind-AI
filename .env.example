# GreenMind AI - Docker Compose / backend environment template
# Copy to .env for local demo. Never commit secrets.
DEMO_MODE=true
APP_ENV=development
APP_NAME=GreenMind AI
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# Exact-match CORS allowlist; add deployed frontend origins explicitly.
ALLOWED_ORIGINS=https://green-mind-ai-ten.vercel.app,https://greenmind-ai.vercel.app,https://green-mind-2shiqlt61-pratham-stack-coders-projects.vercel.app
CORS_ORIGINS=

# Supabase backend authentication (set real project values before auth use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SQLite default when blank; Compose config injects PostgreSQL for its backend service.
DATABASE_URL=
REDIS_URL=

# Optional LLM keys; rule-based Copilot should work without them.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Optional read-only provider telemetry credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# Optional carbon provider API credentials; built-in regional values are estimates.
ELECTRICITY_MAPS_API_KEY=
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
