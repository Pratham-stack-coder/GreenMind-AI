# GreenMind AI — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# See SECURITY.md for credential handling requirements.

# ── Application Mode ──────────────────────────────────────────────────────────
# Set to "false" to enable LIVE cloud connections.
# When true: all data is synthetic DEMO data clearly labeled as such.
# When false: provider credentials below are required for LIVE telemetry.
DEMO_MODE=true

# Application version (informational only)
APP_VERSION=2.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel frontend URL)
# Example: CORS_ORIGINS=https://greenmind-ai.vercel.app,https://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (ephemeral, good for local dev)
# Set to PostgreSQL URL for production persistence:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/greenmind
DATABASE_URL=

# ── Redis Cache (optional) ────────────────────────────────────────────────────
# Leave blank to disable Redis caching
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── LLM Copilot (optional) ────────────────────────────────────────────────────
# Provide at least one for AI-powered Copilot responses.
# Without these, Copilot falls back to deterministic rule-based responses.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Which model to use (examples: gemini-1.5-pro, gpt-4o-mini)
LLM_MODEL=gemini-1.5-pro

# ── AWS Live Telemetry ────────────────────────────────────────────────────────
# Required for AWS CloudWatch live metrics.
# IAM permissions needed: cloudwatch:GetMetricData, ec2:DescribeInstances, sts:GetCallerIdentity
# Optional (for billing data): ce:GetCostAndUsage
# GreenMind AI is READ-ONLY — no write permissions needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional: AWS session token (for STS temporary credentials)
# AWS_SESSION_TOKEN=

# ── Azure Live Telemetry ──────────────────────────────────────────────────────
# Required for Azure Monitor live metrics.
# App registration must have "Monitoring Reader" role on subscription.
# GreenMind AI is READ-ONLY — no write permissions needed.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── GCP Live Telemetry ────────────────────────────────────────────────────────
# Required for Google Cloud Monitoring live metrics.
# Service account must have "roles/monitoring.viewer" IAM role.
# GreenMind AI is READ-ONLY — no write permissions needed.
GCP_PROJECT_ID=
# Paste the full service account JSON as a single line (or path to key file)
GCP_SERVICE_ACCOUNT_JSON=

# ── Optional: Real-Time Carbon Intensity Providers ────────────────────────────
# Without these, carbon intensity uses the built-in ESTIMATED regional curves.
# Electricity Maps API (https://www.electricitymaps.com/free-tier-api)
ELECTRICITY_MAPS_API_KEY=
# WattTime API (https://www.watttime.org/get-the-api/)
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
