# ==============================================================================
# GreenMind AI — Environment Configuration Template
# ==============================================================================

# Application Mode
DEMO_MODE=true
APP_NAME=GreenMind AI
APP_VERSION=2.0.0
DEBUG=false
PORT=8000

# ── Database & Redis Configuration ──────────────────────────────────────────
# For Docker Compose, database secrets are parameterized and not exposed publicly:
POSTGRES_USER=greenmind
POSTGRES_PASSWORD=greenmind_secure_pass
POSTGRES_DB=greenmind
# DATABASE_URL=postgresql+asyncpg://greenmind:greenmind_secure_pass@localhost:5432/greenmind
# REDIS_URL=redis://localhost:6379/0

# ── Monitoring & Observability ──────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── Optional LLM Copilot Keys ───────────────────────────────────────────────
# (Defaults to intelligent deterministic telemetry engine if not set)
# GEMINI_API_KEY=your_google_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Optional Real-Time Carbon Intensity Providers ───────────────────────────
# ELECTRICITY_MAPS_API_KEY=your_electricity_maps_token
# WATTTIME_USERNAME=your_watttime_username
# WATTTIME_PASSWORD=your_watttime_password

# ── Optional Multi-Cloud Live Telemetry Credentials ─────────────────────────
# AWS CloudWatch (requires AWS credentials; note that memory/disk requires CWAgent)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Azure Monitor (requires Azure Active Directory app registration)
# AZURE_SUBSCRIPTION_ID=...
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...

# Google Cloud Monitoring (requires GCP project and service account)
# GCP_PROJECT_ID=...
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
