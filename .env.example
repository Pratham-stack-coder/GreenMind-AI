# GreenMind AI — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# See SECURITY.md for credential handling requirements.

# ── Application Mode ──────────────────────────────────────────────────────────
# Set to "false" to allow configured credentials to provide LIVE telemetry.
# Authenticated users configure their own credentials in Settings; credentials below
# are reserved for backend-managed system/background operations.
DEMO_MODE=true

# Application version (informational only)
APP_VERSION=2.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel frontend URL)
# Example: CORS_ORIGINS=https://greenmind-ai.vercel.app,https://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Protects API routes by verifying Supabase access tokens. Never put a
# service_role key or JWT signing secret in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
# Needed only if this Supabase project still signs access tokens with legacy HS256.
# For HS256 tokens, backend validation is delegated to Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=

# Public Supabase values embedded in the frontend Docker image.
# Use only the publishable key here, never a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Leave blank for the Docker Compose Nginx proxy (/api/v1 -> backend).
VITE_API_BASE_URL=

# ── Per-user Cloud Credential Encryption ──────────────────────────────────────
# Required before users can save provider credentials in Settings.
# Generate a Fernet key once and keep it stable for the lifetime of the database.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (ephemeral, good for local dev)
# Set to PostgreSQL URL for production persistence:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/greenmind
DATABASE_URL=

# ── Redis Cache (optional) ────────────────────────────────────────────────────
# Leave blank to disable Redis caching
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── LLM Copilot (optional) ────────────────────────────────────────────────────
# Server keys are reserved for backend-managed system operations. Authenticated
# users save their own keys in Settings; otherwise Copilot uses deterministic responses.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Which model to use (examples: gemini-1.5-pro, gpt-4o-mini)
LLM_MODEL=gemini-1.5-pro

# ── AWS Live Telemetry ────────────────────────────────────────────────────────
# Optional system/background AWS credentials. Signed-in users configure their own
# credentials in Settings. IAM permissions: cloudwatch:GetMetricData,
# ec2:DescribeInstances, sts:GetCallerIdentity.
# Optional (for billing data): ce:GetCostAndUsage
# GreenMind AI is READ-ONLY — no write permissions needed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Optional: AWS session token (for STS temporary credentials)
# AWS_SESSION_TOKEN=

# ── Azure Live Telemetry ──────────────────────────────────────────────────────
# Optional system/background Azure credentials. Signed-in users configure their own
# credentials in Settings. App registration needs "Monitoring Reader".
# GreenMind AI is READ-ONLY — no write permissions needed.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── GCP Live Telemetry ────────────────────────────────────────────────────────
# Optional system/background GCP credentials. Signed-in users configure their own
# credentials in Settings. The service account needs roles/monitoring.viewer.
# GreenMind AI is READ-ONLY — no write permissions needed.
GCP_PROJECT_ID=
# Paste the full service account JSON as a single line (or path to key file)
GCP_SERVICE_ACCOUNT_JSON=

# ── Optional: Real-Time Carbon Intensity Providers ────────────────────────────
# Without these, carbon intensity uses the built-in ESTIMATED regional curves.
# Electricity Maps API (https://www.electricitymaps.com/free-tier-api)
ELECTRICITY_MAPS_API_KEY=
# WattTime API (https://www.watttime.org/get-the-api/)
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
