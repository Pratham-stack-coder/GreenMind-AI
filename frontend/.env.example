# Vite variables are public and embedded in the browser bundle.
# Never put server-side secrets, service-role keys, or signing secrets here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Optional override. Blank uses the Vite proxy on localhost; deployed browser hosts fall back to the backend default in src/api/client.ts.
VITE_API_BASE_URL=
