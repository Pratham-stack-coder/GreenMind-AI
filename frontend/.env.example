# Vite embeds VITE_* values in the browser bundle. These are public Supabase
# project identifiers/keys only; never put a service-role key or signing secret here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Existing Render FastAPI service. Leave blank for local Vite proxy development.
VITE_API_BASE_URL=https://greenmind-backend-zqn5.onrender.com
