# Vite variables are public and embedded in the browser bundle.
# Never put server-side secrets, service-role keys, or signing secrets here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Blank uses Vite's local /api proxy. Set the deployed backend URL for production.
VITE_API_BASE_URL=
